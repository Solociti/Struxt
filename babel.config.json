{
  "presets": [
    "@babel/preset-typescript",
    [
      "@babel/preset-env",
      {
        "targets": {
          "node": "current"
        },
        "modules": false
      }
    ]
  ],
  "plugins": [
    [
      "module-resolver",
      {
        "root": ["./"],
        "alias": {
          "server": "./server",
          "common": "./common"
        }
      }
    ],
    ["babel-plugin-module-extension-resolver"]
  ]
}
