{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/Halifax",
  "schedule": ["before 8am on Monday"],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "matchPackageNames": ["@types/bull", "bullmq", "@bull-board/express"],
      "groupName": "BullMQ"
    },
    {
      "matchPackageNames": ["grapesjs", "/grapesjs-*/"],
      "groupName": "GrapesJS"
    },
    {
      "matchPackageNames": ["bootstrap", "react-bootstrap"],
      "groupName": "Bootstrap"
    },
    {
      "matchPackageNames": ["sass", "sass-embedded"],
      "groupName": "Sass"
    },
    {
      "matchPackageNames": [
        "react",
        "@types/react",
        "/react-*/",
        "/@types/react-*/"
      ],
      "groupName": "React"
    }
  ]
}
