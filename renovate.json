{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/Halifax",
  "schedule": ["before 8am on Monday"],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "matchPackageNames": ["@types/bull", "bullmq", "@bull-board/express"],
      "groupName": "BullMQ"
    },
    {
      "matchPackageNames": ["grapesjs", "grapesjs-*", "@grapesjs/*"],
      "groupName": "GrapesJS"
    },
    {
      "matchPackageNames": ["bootstrap", "react-bootstrap"],
      "groupName": "Bootstrap"
    },
    {
      "matchPackageNames": ["sass", "sass-embedded"],
      "groupName": "Sass"
    },
    {
      "matchPackageNames": [
        "react",
        "@types/react",
        "/react-*/",
        "/@types/react-*/"
      ],
      "groupName": "React"
    },
    {
      "matchPackageNames": ["langchain", "@langchain/*"],
      "groupName": "LangChain"
    },
    {
      "matchPackageNames": ["sanitize-html", "@types/sanitize-html"],
      "groupName": "Sanitize HTML"
    },
    {
      "matchPackageNames": ["nodemailer", "@types/nodemailer"],
      "groupName": "Nodemailer"
    },
    {
      "matchPackageNames": [
        "@babel/*",
        "babel-plugin-module-extension-resolver",
        "babel-plugin-module-resolver"
      ],
      "groupName": "Babel"
    },
    {
      "matchPackageNames": [
        "vite",
        "@vitejs/plugin-react",
        "vite-plugin-pwa",
        "vite-svg-loader"
      ],
      "groupName": "Vite"
    },
    {
      "matchPackageNames": ["socket.io", "socket.io-client"],
      "groupName": "Socket.IO"
    }
  ]
}
